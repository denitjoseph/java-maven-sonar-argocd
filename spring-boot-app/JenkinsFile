pipeline {

    agent {
        docker {
            image 'maven-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                sh 'echo passed'
                // git branch: 'main', url: 'https://github.com/user/repo.git'
            }
        }

        stage('Build and Test') {
            steps {
                sh 'ls -ltr'

                sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {

                    def scannerHome = tool 'sonarscanner'

                    withSonarQubeEnv('sonarqube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=my-ec2-project \
                                -Dsonar.sources=java-maven-sonar-argocd-helm-k8s/spring-boot-app/src/main/java \
                                -Dsonar.java.binaries=java-maven-sonar-argocd-helm-k8s/spring-boot-app/target/classes \
                                -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {

                    sh "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} ."

                    def dockerImage = docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                        dockerImage.push("latest")
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh """
                        git config user.email "denitjoseph@github.com"
                        git config user.name "${GITHUB_USERNAME}"

                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" K8s/deployment.yaml

                        echo "Updated Kubernetes deployment:"
                        grep "image:" K8s/deployment.yaml

                        git add K8s/deployment.yaml

                        git commit -m "Update app image tag to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"

                        git push https://\\${GITHUB_TOKEN}@github.com/${GITHUB_USERNAME}/${GIT_REPO_NAME}.git HEAD:main
                    """
                }
            }
        }
    }
}
