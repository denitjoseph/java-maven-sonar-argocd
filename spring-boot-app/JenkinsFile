pipeline {

    agent {
        docker {
            image 'maven-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_IMAGE = 'denitjoseph/ultimate-cicd'
        GIT_REPO_NAME = 'java-maven-sonar-argocd'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code checked out by Jenkins SCM.'

                sh '''
                    echo "Current workspace:"
                    pwd

                    echo "Files in workspace:"
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    echo "Building Spring Boot application..."

                    cd spring-boot-app

                    mvn clean package
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {

                    sh '''
                        echo "Running SonarQube analysis..."

                        cd spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                          -Dsonar.projectKey=my-ec2-project \
                          -Dsonar.projectName="Spring Boot App" \
                          -Dsonar.host.url=$SONAR_HOST_URL
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {

                    echo "Building Docker image..."

                    sh """
                        docker build \
                            -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                            ./spring-boot-app
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {

                    echo "Pushing Docker image to Docker Hub..."

                    def dockerImage =
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {

                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "========================================"
                        echo "Updating Kubernetes Deployment"
                        echo "========================================"

                        echo "Current workspace:"
                        pwd

                        echo "Marking workspace as Git safe directory..."

                        git config --global --add safe.directory "$(pwd)"

                        echo "Updating image tag..."

                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                            spring-boot-app-manifests/deployment.yml

                        echo "Updated deployment image:"
                        grep "image:" spring-boot-app-manifests/deployment.yml

                        echo "========================================"
                        echo "Configuring Git"
                        echo "========================================"

                        git config user.email "denitjoseph25@gmail.com"
                        git config user.name "$GITHUB_USERNAME"

                        echo "========================================"
                        echo "Adding deployment file"
                        echo "========================================"

                        git add spring-boot-app-manifests/deployment.yml

                        echo "========================================"
                        echo "Creating commit"
                        echo "========================================"

                        git commit \
                            -m "Update Spring Boot image to ${BUILD_NUMBER} [skip ci]" \
                            || echo "No changes to commit"

                        echo "========================================"
                        echo "Pushing changes to GitHub"
                        echo "========================================"

                        git push \
                            "https://${GITHUB_TOKEN}@github.com/${GITHUB_USERNAME}/${GIT_REPO_NAME}.git" \
                            HEAD:main

                        echo "========================================"
                        echo "Deployment file pushed successfully!"
                        echo "========================================"
                    '''
                }
            }
        }
    }
}
